local function Notify(featureName, state)
    local notifFrame = Instance.new("Frame")
    notifFrame.Size = UDim2.new(1, 0, 0, 32)
    notifFrame.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    notifFrame.BorderSizePixel = 0
    notifFrame.BackgroundTransparency = 1

    local stroke = Instance.new("UIStroke")
    stroke.Color = state and Color3.fromRGB(80, 220, 120) or Color3.fromRGB(220, 80, 80)
    stroke.Thickness = 1.5
    stroke.Transparency = 1
    stroke.Parent = notifFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = notifFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = featureName .. " : " .. (type(state) == "boolean" and (state and "ON" or "OFF") or tostring(state))
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTransparency = 1
    label.Parent = notifFrame

    notifFrame.Parent = NotifContainer

    TweenService:Create(notifFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0.15}):Play()
    TweenService:Create(stroke, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Transparency = 0.3}):Play()
    TweenService:Create(label, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()

    task.delay(2.2, function()
        local fadeBg = TweenService:Create(notifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1})
        local fadeStr = TweenService:Create(stroke, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1})
        local fadeLbl = TweenService:Create(label, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1})
        
        fadeBg:Play()
        fadeStr:Play()
        fadeLbl:Play()
        
        fadeBg.Completed:Connect(function()
            notifFrame:Destroy()
        end)
    end)
end

