RunService.Stepped:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local hum = myChar:FindFirstChild("Humanoid")
    local hrp = myChar:FindFirstChild("HumanoidRootPart")

    if hum then
        if MovementState.WalkSpeedEnabled then
            hum.WalkSpeed = MovementState.WalkSpeedValue
            
            -- Walk Speed Bypass (Hook/Anti-clamp mechanism for strict games)
            if MovementState.WalkSpeedBypass then
                pcall(function()
                    if hum.WalkSpeed ~= MovementState.WalkSpeedValue then
                        hum.WalkSpeed = MovementState.WalkSpeedValue
                    end
                end)
            end
        end

        if MovementState.JumpBoostEnabled then
            hum.UseJumpPower = true
            hum.JumpPower = MovementState.JumpPowerValue
        end
    end

    if MovementState.NoClipEnabled and myChar then
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if MovementState.AntiFallDamage and hrp and hum then
        local velY = hrp.Velocity.Y
        if velY < -25 then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {myChar}
            local result = workspace:Raycast(hrp.Position, Vector3.new(0, -14, 0), rayParams)
            if result then
                hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
    end

    -- AUTO STRAFE LOGIC (Air momentum & direction control)
    if MovementState.AutoStrafeEnabled and hrp and hum then
        if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Jumping then
            local cameraCFrame = Camera.CFrame
            local speed = MovementState.WalkSpeedEnabled and MovementState.WalkSpeedValue or 16
            local moveDir = Vector3.new(0, 0, 0)

            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cameraCFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cameraCFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cameraCFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cameraCFrame.RightVector end

            if moveDir.Magnitude > 0 then
                moveDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
                hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * speed, hrp.AssemblyLinearVelocity.Y, moveDir.Z * speed)
            end
        end
    end

    if MovementState.FlyEnabled and hrp then
        local bv = hrp:FindFirstChild("BrUnivFlyVelocity")
        local bg = hrp:FindFirstChild("BrUnivFlyGyro")

        if bv and bg then
            bg.CFrame = Camera.CFrame
            local moveDir = Vector3.new(0, 0, 0)
            if FlyKeys[Enum.KeyCode.W] then moveDir = moveDir + Camera.CFrame.LookVector end
            if FlyKeys[Enum.KeyCode.S] then moveDir = moveDir - Camera.CFrame.LookVector end
            if FlyKeys[Enum.KeyCode.A] then moveDir = moveDir - Camera.CFrame.RightVector end
            if FlyKeys[Enum.KeyCode.D] then moveDir = moveDir + Camera.CFrame.RightVector end
            if FlyKeys[Enum.KeyCode.Space] then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if FlyKeys[Enum.KeyCode.LeftShift] then moveDir = moveDir - Vector3.new(0, 1, 0) end

            bv.Velocity = moveDir * MovementState.FlySpeedValue
        end
    else
        if hrp then
            if hrp:FindFirstChild("BrUnivFlyVelocity") then hrp.BrUnivFlyVelocity:Destroy() end
            if hrp:FindFirstChild("BrUnivFlyGyro") then hrp.BrUnivFlyGyro:Destroy() end
        end
    end
end)

