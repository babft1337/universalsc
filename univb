                part.CanCollide = false
            end
        end
    end

    -- Anti Fall Damage Logic
    if MovementState.AntiFallDamage and hrp then
        local velY = hrp.Velocity.Y
        if velY < -50 then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {myChar}
            local result = workspace:Raycast(hrp.Position, Vector3.new(0, -8, 0), rayParams)
            if result then
                hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
            end
        end
    end

    if MovementState.FlyEnabled and hrp then
        local bv = hrp:FindFirstChild("BrUnivFlyVelocity")
        local bg = hrp:FindFirstChild("BrUnivFlyGyro")

        if bv and bg then
            bg.CFrame = Camera.CFrame
            local moveDir = Vector3.new(0, 0, 0)
            if FlyKeys[Enum.KeyCode.W] then moveDir = moveDir + Camera.CFrame.LookVector end
            if FlyKeys[Enum.KeyCode.S] then moveDir = moveDir - Camera.CFrame.LookVector end
            if FlyKeys[Enum.KeyCode.A] then moveDir = moveDir - Camera.CFrame.RightVector end
            if FlyKeys[Enum.KeyCode.D] then moveDir = moveDir + Camera.CFrame.RightVector end
            if FlyKeys[Enum.KeyCode.Space] then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if FlyKeys[Enum.KeyCode.LeftShift] then moveDir = moveDir - Vector3.new(0, 1, 0) end

            bv.Velocity = moveDir * MovementState.FlySpeedValue
        end
