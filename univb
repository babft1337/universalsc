local function ApplyTheme()
    local bgMain = isDarkTheme and Color3.fromRGB(5, 5, 5) or Color3.fromRGB(245, 245, 245)
    local bgSub = isDarkTheme and Color3.fromRGB(8, 8, 8) or Color3.fromRGB(235, 235, 235)
    local bgElement = isDarkTheme and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(225, 225, 225)
    local textMain = isDarkTheme and Color3.fromRGB(230, 230, 230) or Color3.fromRGB(20, 20, 20)
    local textSub = isDarkTheme and Color3.fromRGB(160, 160, 160) or Color3.fromRGB(90, 90, 90)
    local strokeCol = isDarkTheme and Color3.fromRGB(40, 40, 40) or Color3.fromRGB(200, 200, 200)

    local floatingBg = isDarkTheme and Color3.fromRGB(8, 8, 8) or Color3.fromRGB(235, 235, 235)
    local floatingText = isDarkTheme and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(20, 20, 20)
    local floatingSubText = isDarkTheme and Color3.fromRGB(180, 180, 180) or Color3.fromRGB(60, 60, 60)

    TweenService:Create(MainFrame, TweenInfo.new(0.35), {BackgroundColor3 = bgMain}):Play()
    TweenService:Create(MainStroke, TweenInfo.new(0.35), {Color = strokeCol}):Play()
    TweenService:Create(TitleLabel, TweenInfo.new(0.35), {TextColor3 = textMain}):Play()
    TweenService:Create(TabBar, TweenInfo.new(0.35), {BackgroundColor3 = bgSub}):Play()
    TweenService:Create(ContentContainer, TweenInfo.new(0.35), {BackgroundColor3 = bgSub}):Play()
    TweenService:Create(ThemeToggleBtn, TweenInfo.new(0.35), {BackgroundColor3 = bgElement, TextColor3 = textMain}):Play()
    TweenService:Create(ThemeStroke, TweenInfo.new(0.35), {Color = strokeCol}):Play()

    TweenService:Create(WatermarkFrame, TweenInfo.new(0.35), {BackgroundColor3 = floatingBg}):Play()
    TweenService:Create(WatermarkStroke, TweenInfo.new(0.35), {Color = strokeCol}):Play()
    TweenService:Create(WatermarkText, TweenInfo.new(0.35), {TextColor3 = floatingText}):Play()

    TweenService:Create(MiniUIFrame, TweenInfo.new(0.35), {BackgroundColor3 = floatingBg}):Play()
    TweenService:Create(MiniStroke, TweenInfo.new(0.35), {Color = strokeCol}):Play()
    TweenService:Create(MiniTitle, TweenInfo.new(0.35), {TextColor3 = floatingText}):Play()
    TweenService:Create(MiniStatsLabel, TweenInfo.new(0.35), {TextColor3 = floatingSubText}):Play()

    TweenService:Create(OpenBtnStroke, TweenInfo.new(0.35), {Color = strokeCol}):Play()
    TweenService:Create(OpenBtnText, TweenInfo.new(0.35), {TextColor3 = floatingText}):Play()

    TweenService:Create(MobileAimBtn, TweenInfo.new(0.35), {BackgroundColor3 = floatingBg, TextColor3 = floatingText}):Play()
    TweenService:Create(MobileAimStroke, TweenInfo.new(0.35), {Color = strokeCol}):Play()

    for _, card in pairs(ArrayListCards) do
        if card and card.Parent then
            TweenService:Create(card, TweenInfo.new(0.35), {BackgroundColor3 = floatingBg}):Play()
            local str = card:FindFirstChildOfClass("UIStroke")
            local lbl = card:FindFirstChildOfClass("TextLabel")
            if str then TweenService:Create(str, TweenInfo.new(0.35), {Color = strokeCol}):Play() end
            if lbl then TweenService:Create(lbl, TweenInfo.new(0.35), {TextColor3 = floatingText}):Play() end
        end
    end

    for _, tabBtn in pairs(TabButtons) do
        if tabBtn and tabBtn.Parent then
            local isSelected = (Pages[tabBtn.Text] and Pages[tabBtn.Text].Visible)
            TweenService:Create(tabBtn, TweenInfo.new(0.35), {
                BackgroundColor3 = isSelected and (isDarkTheme and Color3.fromRGB(25, 25, 25) or Color3.fromRGB(200, 200, 200)) or bgElement,
                TextColor3 = isSelected and (isDarkTheme and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(10, 10, 10)) or textSub
            }):Play()
        end
    end

    for _, page in pairs(Pages) do
        if page and page.Parent then
            for _, child in ipairs(page:GetChildren()) do
                if child:IsA("Frame") or child:IsA("TextButton") then
                    TweenService:Create(child, TweenInfo.new(0.35), {BackgroundColor3 = bgElement}):Play()
                    for _, sub in ipairs(child:GetDescendants()) do
                        if sub:IsA("TextLabel") then
                            TweenService:Create(sub, TweenInfo.new(0.35), {TextColor3 = textMain}):Play()
                        elseif sub:IsA("TextButton") and sub ~= child then
                            TweenService:Create(sub, TweenInfo.new(0.35), {
                                BackgroundColor3 = isDarkTheme and Color3.fromRGB(28, 28, 28) or Color3.fromRGB(200, 200, 200),
                                TextColor3 = textMain
                            }):Play()
                        elseif sub:IsA("TextBox") then
                            TweenService:Create(sub, TweenInfo.new(0.35), {
                                BackgroundColor3 = isDarkTheme and Color3.fromRGB(25, 25, 25) or Color3.fromRGB(190, 190, 190),
                                TextColor3 = textMain
                            }):Play()
                        end
                    end
                end
            end
        end
    end
end

