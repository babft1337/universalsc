local ArrayListCards = {}

local function UpdateArrayList()
    if not ESPState.ArrayList then
        ArrayListContainer.Visible = false
        return
    end
    ArrayListContainer.Visible = true

    local activeFeatures = {
        {Name = "Aim Lock", Active = CombatState.Enabled},
        {Name = "Walk Speed", Active = MovementState.WalkSpeedEnabled},
        {Name = "Jump Boost", Active = MovementState.JumpBoostEnabled},
        {Name = "Fly", Active = MovementState.FlyEnabled},
        {Name = "NoClip", Active = MovementState.NoClipEnabled},
        {Name = "Anti Fall Damage", Active = MovementState.AntiFallDamage},
        {Name = "Auto Strafe", Active = MovementState.AutoStrafeEnabled},
        {Name = "Boost FPS", Active = ESPState.BoostFPS},
        {Name = "Mini UI", Active = PerformanceState.MiniUIEnabled}
    }

    for _, feat in ipairs(activeFeatures) do
        local existing = ArrayListCards[feat.Name]
        if feat.Active then
            if not existing then
                local card = Instance.new("Frame")
                card.Size = UDim2.new(0, 0, 0, 26)
                card.BackgroundColor3 = isDarkTheme and Color3.fromRGB(8, 8, 8) or Color3.fromRGB(235, 235, 235)
                card.BackgroundTransparency = 1
                card.BorderSizePixel = 0
                card.Parent = ArrayListContainer

                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 6)
                corner.Parent = card

                local stroke = Instance.new("UIStroke")
                stroke.Color = isDarkTheme and Color3.fromRGB(45, 45, 45) or Color3.fromRGB(200, 200, 200)
                stroke.Transparency = 1
                stroke.Thickness = 1.2
                stroke.Parent = card

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -12, 1, 0)
                label.Position = UDim2.new(0, 6, 0, 0)
                label.BackgroundTransparency = 1
                label.Text = feat.Name
                label.TextColor3 = isDarkTheme and Color3.fromRGB(230, 230, 230) or Color3.fromRGB(20, 20, 20)
                label.TextTransparency = 1
                label.Font = Enum.Font.GothamMedium
                label.TextSize = 10.5
                label.TextXAlignment = Enum.TextXAlignment.Right
                label.Parent = card

                ArrayListCards[feat.Name] = card

                TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 140, 0, 26),
                    BackgroundTransparency = isDarkTheme and 0.15 or 0.1
                }):Play()
                TweenService:Create(stroke, TweenInfo.new(0.3), {Transparency = 0.3}):Play()
                TweenService:Create(label, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
            end
        else
            if existing then
                ArrayListCards[feat.Name] = nil
                local card = existing
                local stroke = card:FindFirstChildOfClass("UIStroke")
                local label = card:FindFirstChildOfClass("TextLabel")

                local tw1 = TweenService:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 0, 26),
                    BackgroundTransparency = 1
                })
                if stroke then TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 1}):Play() end
                if label then TweenService:Create(label, TweenInfo.new(0.25), {TextTransparency = 1}):Play() end

                tw1:Play()
                tw1.Completed:Connect(function()
                    card:Destroy()
                end)
            end
        end
    end
end

