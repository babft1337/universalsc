local function TriggerBoostFPS(state)
    ESPState.BoostFPS = state
    if state then
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            OriginalPartsData = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    OriginalPartsData[obj] = {Material = obj.Material, CastShadow = obj.CastShadow}
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.CastShadow = false
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    OriginalPartsData[obj] = {Transparency = obj.Transparency}
                    obj.Transparency = 1
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
                    OriginalPartsData[obj] = {Enabled = obj.Enabled}
                    obj.Enabled = false
                end
            end
        end)
    else
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            Lighting.GlobalShadows = OriginalLighting.GlobalShadows
            Lighting.FogEnd = OriginalLighting.FogEnd
            for obj, props in pairs(OriginalPartsData) do
                if obj and obj.Parent then
                    if obj:IsA("BasePart") then
                        if props.Material then obj.Material = props.Material end
                        if props.CastShadow ~= nil then obj.CastShadow = props.CastShadow end
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then
                        if props.Transparency ~= nil then obj.Transparency = props.Transparency end
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
                        if props.Enabled ~= nil then obj.Enabled = props.Enabled end
                    end
                end
            end
            OriginalPartsData = {}
        end)
    end
end

