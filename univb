                        local hl = Instance.new("Highlight")
                        hl.FillColor = targetColor
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.5
                        hl.Parent = char
                        ChamsHighlights[player] = hl
                    else
                        ChamsHighlights[player].FillColor = targetColor
                    end
                end

                if head and hrp then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    local rootScreenPos, rootOnScreen = Camera:WorldToViewportPoint(hrp.Position)

                    if onScreen or rootOnScreen then
                        local myChar = LocalPlayer.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        local dist = myRoot and math.floor((head.Position - myRoot.Position).Magnitude) or 0

                        if ESPState.Tracers and rootOnScreen then
                            local tracer = NewLine(1.5, targetColor)
                            tracer.From = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                            tracer.To = Vector2.new(rootScreenPos.X, rootScreenPos.Y)
                            table.insert(ESPDrawings, tracer)
                        end

                        local yOffset = -20
                        if ESPState.Name then
                            local t = NewText(player.Name, 13, targetColor)
                            t.Position = Vector2.new(screenPos.X, screenPos.Y + yOffset)
                            table.insert(ESPDrawings, t)
                            yOffset = yOffset + 14
                        end

                        if ESPState.Health and hum then
                            local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                            local hpColor = Color3.fromHSV(hpPercent * 0.35, 0.9, 1)
                            local hpText = NewText("[" .. math.floor(hum.Health) .. " HP]", 12, hpColor)
                            hpText.Position = Vector2.new(screenPos.X, screenPos.Y + yOffset)
                            table.insert(ESPDrawings, hpText)
                            yOffset = yOffset + 14
                        end

                        if ESPState.Distance or CombatState.ShowDistance then
                            local t = NewText(tostring(dist) .. " studs", 12, targetColor)
                            t.Position = Vector2.new(screenPos.X, screenPos.Y + yOffset)
                            table.insert(ESPDrawings, t)
                        end
                    end
                end
            end
        end

        local myChar = LocalPlayer.Character
        if ESPState.ChinaHat and myChar and myChar:FindFirstChild("Head") then
            local head = myChar.Head
            if not ChinaHatPart or not ChinaHatPart.Parent then
                ChinaHatPart = Instance.new("Part")
                ChinaHatPart.Name = "ChinaHatEffect"
                ChinaHatPart.Size = Vector3.new(3, 0.8, 3)
                ChinaHatPart.Anchored = true
                ChinaHatPart.CanCollide = false
                ChinaHatPart.Material = Enum.Material.SmoothPlastic
                
                local mesh = Instance.new("SpecialMesh")
                mesh.MeshType = Enum.MeshType.FileMesh
                mesh.MeshId = "rbxassetid://1033714"
                mesh.Scale = Vector3.new(2.5, 1.2, 2.5)
                mesh.Parent = ChinaHatPart
                ChinaHatPart.Parent = workspace
            end
            
            local val = 0.5 + 0.5 * math.sin(tick() * 3)
            ChinaHatPart.Color = Color3.new(val, val, val)
            
            local camDist = (Camera.CFrame.Position - head.Position).Magnitude
            if camDist < 1.6 then
                ChinaHatPart.Transparency = 1
            else
                ChinaHatPart.Transparency = 0
            end

            ChinaHatPart.CFrame = head.CFrame * CFrame.new(0, 1.1, 0) * CFrame.Angles(0, math.rad(tick() * 120 % 360), 0)
        end
    end)
end)
