local function AddToggle(parent, text, default, callback, featureKey)
    local state = default
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = isDarkTheme and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(225, 225, 225)
    btn.BorderSizePixel = 0
    btn.Text = "  " .. text .. ": " .. (state and "[ ON ]" or "[ OFF ]")
    btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 140)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent

    local function applyState(newState, skipNotify)
        state = newState
        btn.Text = "  " .. text .. ": " .. (state and "[ ON ]" or "[ OFF ]")
        btn.TextColor3 = state and (isDarkTheme and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(10, 10, 10)) or Color3.fromRGB(140, 140, 140)
        callback(state)
        UpdateArrayList()
        if not skipNotify then
            Notify(text, state)
        end
    end

    btn.MouseButton1Click:Connect(function()
        applyState(not state, false)
    end)

    if featureKey then
        FeatureRegistry[featureKey] = {
            Get = function() return state end,
            Set = function(newState, skipNotify) applyState(newState, skipNotify) end
        }
    end

    return btn, applyState
end

local function AddToggleWithInput(parent, text, defaultState, defaultValue, callbackToggle, callbackValue, featureKey)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.BackgroundColor3 = isDarkTheme and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(225, 225, 225)
    frame.BorderSizePixel = 0
    frame.Parent = parent

    local state = defaultState
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.7, -5, 1, 0)
    btn.Position = UDim2.new(0, 0, 0, 0)
    btn.BackgroundTransparency = 1
    btn.Text = "  " .. text .. ": " .. (state and "[ ON ]" or "[ OFF ]")
    btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 140)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.3, 0, 1, -6)
    box.Position = UDim2.new(0.7, 0, 0, 3)
    box.BackgroundColor3 = isDarkTheme and Color3.fromRGB(25, 25, 25) or Color3.fromRGB(190, 190, 190)
    box.BorderSizePixel = 0
    box.Text = tostring(defaultValue)
    box.TextColor3 = isDarkTheme and Color3.fromRGB(220, 220, 220) or Color3.fromRGB(20, 20, 20)
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.Parent = frame

    local function applyState(newState, skipNotify)
        state = newState
        btn.Text = "  " .. text .. ": " .. (state and "[ ON ]" or "[ OFF ]")
        btn.TextColor3 = state and (isDarkTheme and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(10, 10, 10)) or Color3.fromRGB(140, 140, 140)
        callbackToggle(state)
        UpdateArrayList()
        if not skipNotify then
            Notify(text, state)
        end
    end

    btn.MouseButton1Click:Connect(function()
        applyState(not state, false)
    end)

    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then
            callbackValue(num)
        else
            box.Text = tostring(defaultValue)
        end
    end)

    if featureKey then
        FeatureRegistry[featureKey] = {
            Get = function() return state end,
            Set = function(newState, skipNotify) applyState(newState, skipNotify) end
        }
    end

    return btn, applyState
end

local function AddSlider(parent, text, min, max, default, callback)
    local val = default
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 42)
    frame.BackgroundColor3 = isDarkTheme and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(225, 225, 225)
    frame.BorderSizePixel = 0
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 20)
    label.Position = UDim2.new(0, 5, 0, 2)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. tostring(val)
    label.TextColor3 = isDarkTheme and Color3.fromRGB(200, 200, 200) or Color3.fromRGB(30, 30, 30)
    label.Font = Enum.Font.Gotham
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local sliderBar = Instance.new("TextButton")
    sliderBar.Size = UDim2.new(1, -10, 0, 12)
    sliderBar.Position = UDim2.new(0, 5, 0, 24)
    sliderBar.BackgroundColor3 = isDarkTheme and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(180, 180, 180)
    sliderBar.BorderSizePixel = 0
    sliderBar.Text = ""
    sliderBar.Parent = frame

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(140, 140, 140)
    fill.BorderSizePixel = 0
    fill.Parent = sliderBar

    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
        val = math.floor(min + (max - min) * pos)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        label.Text = text .. ": " .. tostring(val)
        callback(val)
    end

    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

